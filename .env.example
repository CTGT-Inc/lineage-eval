# Synchronous Grok and Gemini judging through OpenRouter.
OPENROUTER_API_KEY=

# Native provider batch judging.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional authentication for an external OpenAI-compatible inference server.
# Set generation.api_key_env="INFERENCE_API_KEY" in the TOML to require it.
INFERENCE_API_KEY=
